# =====================================================
# VeloSync Frontend - Environment Variables Template
# =====================================================
# Copy this file to .env and fill in your actual values.
# DO NOT commit your .env file to Git!

# Your deployed backend API URL (e.g., Railway, Azure, Render, Cloudflare Tunnel)
# Example: https://api.yourdomain.com/api
VITE_API_BASE_URL=https://YOUR_DEPLOYED_BACKEND_URL/api

# Direct SignalR Hub URL (Required for production Vercel to bypass WebSocket proxy limits)
# Example: https://api.yourdomain.com/hubs/stock
VITE_HUB_URL=https://YOUR_DEPLOYED_BACKEND_URL/hubs/stock
